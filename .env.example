# Copy this file to .env and fill in values for the provider you want to use.
# Everything here is optional — with no .env at all (or LLM_PROVIDER=none),
# the system runs end-to-end using the rule-based fallback query parser.

# Which LLM backend to use: "groq", "ollama", or "none" (default: none)
LLM_PROVIDER=groq

# --- Groq (OpenAI-compatible, free tier, no local GPU needed) ---
# Required if LLM_PROVIDER=groq. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Ollama (fully local/offline) ---
# Required if LLM_PROVIDER=ollama. Run `ollama pull <model>` first.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# How long to wait for an LLM response before falling back to the rule-based
# parser, in seconds.
LLM_TIMEOUT_SECONDS=20

# --- App-level settings ---
# Path to the ticket dataset CSV.
DATA_PATH=data/support_tickets.csv

# Python logging level for the app.
LOG_LEVEL=INFO

# Base URL the Streamlit UI (ui/app.py) uses to reach the API.
API_BASE_URL=http://localhost:8000
